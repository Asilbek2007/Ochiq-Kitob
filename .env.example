# OchiqKitob Sozlamalari — Namuna (.env.example)
# Bu faylni nusxalab .env nomli fayl yarating va qiymatlarni to'ldiring

PORT=3000
DATABASE_URL="file:./dev.db"

# Admin Panel (yashirin URL va parol)
ADMIN_SECRET_PATH="kutubxona-boshqaruv"
ADMIN_PASSWORD="PAROL_KIRITING"
SESSION_SECRET="MAXFIY_KALIT_KIRITING"

# Telegram Bot va Kanal sozlamalari
# Botni @BotFather orqali yarating va tokenini shu yerga yozing
TELEGRAM_BOT_TOKEN="BOT_TOKENINGIZNI_KIRITING"
TELEGRAM_CHANNEL_ID="@kanalingiz"
